{
  "name": "dsh-logprobs-highlighter",
  "version": "0.1.0",
  "description": "Highlights the sentences in a DeepSeek Harness reply where the model was least sure of its next token, using token-level logprobs from its own DeepSeek provider route.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "test",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "tojunkan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tojunkan/dsh-logprobs-highlighter.git"
  },
  "homepage": "https://github.com/tojunkan/dsh-logprobs-highlighter#readme",
  "bugs": {
    "url": "https://github.com/tojunkan/dsh-logprobs-highlighter/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "logprobs",
    "confidence",
    "uncertainty"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "entry": "./lib/client.js",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/self-test.mjs",
    "check": "node --check lib/index.js && node --check lib/provider.js && node --check lib/wire.js && node --check lib/sentences.js && node --check lib/capture.js && node --check lib/assoc.js && node --check lib/routes.js && node --check lib/recorder.js && node --check lib/annotations.js && node --check lib/shared.js && node --check scripts/rebuild-annotations.mjs",
    "build:client": "node scripts/build-client.mjs",
    "rebuild:annotations": "node scripts/rebuild-annotations.mjs",
    "analyze": "node scripts/analyze-captures.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
